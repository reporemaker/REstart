<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    tools:context=".ui.HomeFragment">

    <FrameLayout
        android:id="@+id/touchArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="50dp" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/mainView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="20dp"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ch.remaker.components.views.FontAppCompatTextView
                    android:id="@+id/weather"
                    style="@style/TextDefaultStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ch.remaker.components.views.FontAppCompatTextView
                    android:id="@+id/battery"
                    style="@style/TextDefaultStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Clock block. The ring (style "Rings") sits beside the text; the rule under it belongs to "One line". -->
            <LinearLayout
                android:id="@+id/clockRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <ch.remaker.restart.ui.components.RingClockView
                android:id="@+id/ringClock"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginEnd="18dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/timeDateLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginVertical="1dp"
                android:orientation="vertical"
                tools:visibility="visible">

                <ch.remaker.components.views.FontTextClock
                    android:id="@+id/clock"
                    style="@style/TextDefaultStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/time_size"
                    tools:text="02:34" />


                <!-- Date and alarm share a column so the styles can put them beside or under the clock -->
                <LinearLayout
                    android:id="@+id/dateAlarmLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <ch.remaker.components.views.FontTextClock
                    android:id="@+id/date"
                    style="@style/TextDefaultStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="2dp"
                    android:textSize="@dimen/date_size"
                    tools:text="Thu, 30 Dec" />

                <ch.remaker.components.views.FontAppCompatTextView
                    android:id="@+id/alarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/alarm_size"
                    android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/clockRule"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- First run tips -->
        <LinearLayout
            android:id="@+id/firstRunTips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="4dp"
            android:layout_marginTop="106dp"
            android:layout_marginEnd="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ch.remaker.components.views.FontAppCompatTextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tap_button_for_notes" />

            <ch.remaker.components.views.FontAppCompatTextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/swipe_up_for_apps" />

            <ch.remaker.components.views.FontAppCompatTextView
                style="@style/TextSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/long_press_for_settings" />

        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>


    <!-- Home apps-->
    <LinearLayout
        android:id="@+id/homeAppsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="100dp"
        android:paddingBottom="30dp" />

    <ch.remaker.components.views.FontAppCompatTextView
        android:id="@+id/totalScreenTime"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="@string/total_screen_time"
        android:visibility="gone" />

    <!-- Set default launcher -->
    <ch.remaker.components.views.FontAppCompatTextView
        android:id="@+id/setDefaultLauncher"
        style="@style/TextSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:text="@string/advanced_settings_set_as_default_launcher"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/privateLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/privateFab"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/show"
            android:elevation="6dp"
            android:src="@drawable/private_profile_on" />
    </LinearLayout>

    <!-- Quick actions: a 2 dp rule, then the pictograms spread evenly in one row with no
         separators or labels; the RE* mark (notes) closes the row on the right. -->
    <LinearLayout
        android:id="@+id/fabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="?attr/primaryColor" />

        <LinearLayout
            android:id="@+id/fabRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/fabPhone"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:contentDescription="@string/show"
                android:scaleType="fitStart"
                android:src="@drawable/ic_phone" />

            <ImageView
                android:id="@+id/fabMessages"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:contentDescription="@string/show"
                android:scaleType="fitStart"
                android:src="@drawable/ic_messages" />

            <ImageView
                android:id="@+id/fabCamera"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:contentDescription="@string/show"
                android:scaleType="fitStart"
                android:src="@drawable/ic_camera" />

            <ImageView
                android:id="@+id/fabPhotos"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:contentDescription="@string/show"
                android:scaleType="fitStart"
                android:src="@drawable/ic_photos" />

            <ImageView
                android:id="@+id/fabBrowser"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:contentDescription="@string/show"
                android:scaleType="fitStart"
                android:src="@drawable/ic_browser" />

            <ImageView
                android:id="@+id/fabSettings"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:contentDescription="@string/show"
                android:scaleType="fitStart"
                android:src="@drawable/ic_settings" />

            <ImageView
                android:id="@+id/fabAction"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:contentDescription="@string/show"
                android:scaleType="fitEnd"
                android:src="@drawable/branding_image" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
