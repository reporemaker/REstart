<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>

    <!-- Nothing goes to the cloud backup: settings contain notes, hidden and locked apps and a saved location -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>

    <!-- Nor to a direct phone-to-phone transfer: widget ids and profiles do not survive it, and a
         new phone gets everything from a backup file (Settings > Advanced > Backup/Restore) -->
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>

</data-extraction-rules>
