    <!-- Accessibility/Help Strings -->
    <string name="accessibility_service_name">خدمات إجراءات RE*start</string>
    <string name="accessibility_service_why_we_need">لماذا نحتاج إلى إذن تسهيل الوصول؟</string>
    <string name="accessibility_service_description">تتيح خدمة تسهيل الوصول هذه لبرنامج RE*start القيام ببعض الإجراءات مثل قفل الشاشة أو فتح الإعدادات السريعة. ولا تقوم خدمة تسهيل الوصول لدينا بجمع أو مشاركة أي بيانات.</string>
    <string name="accessibility_service_more_info">    يتطلب RE*start الوصول إلى خدمة إمكانية الوصول لتمكين ميزات مثل:\n\n
    - قفل الشاشة باستخدام إيماءة أو اختصار\n
    - فتح لوحة الإعدادات السريعة بسرعة\n\n
    يسمح هذا الإذن لـ RE*start بتنفيذ هذه الإجراءات نيابةً عنك، ولكننا لا نجمع أو نخزن أو نشارك أي بيانات شخصية أو حساسة من خلال هذه الخدمة.\n\n
    يمكنك تعطيل هذا الوصول في أي وقت من إعدادات جهازك.
    </string>
